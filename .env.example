# --- LLM ---------------------------------------------------------------
# ollama (default, local/offline) | anthropic (only if the task rules allow external APIs)
LLM_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
# PLLuM (default) or Bielik:
OLLAMA_MODEL=hf.co/mradermacher/PLLuM-12B-instruct-2512-GGUF:Q5_K_M
# OLLAMA_MODEL=SpeakLeash/bielik-11b-v3.0-instruct:Q5_K_M
OLLAMA_EMBED_MODEL=bge-m3
LLM_TIMEOUT_MS=180000

# Anthropic (credentials can also come from `ant auth login`)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
ANTHROPIC_EFFORT=medium

# --- Graph -------------------------------------------------------------
# Text similarity in build-graph: tfidf (offline) | embedding (Ollama bge-m3) | none
TEXT_SIMILARITY=tfidf
# Linking weights file for /api/analyze and the GUI analysis (default: <VIEWER_DATA_DIR>/linking.json, then <VIEWER_DATA_DIR>/../linking-default.json,
# the built-in weights otherwise; the sample's file only for the sample run)
LINK_CONFIG=

# --- Enrichment (passive lookups) -------------------------------------
CACHE_DIR=.cache
# off = no cache reads/writes
CACHE=on
# off = skip crt.sh (slow)
CT=on
# Comma-separated resolver IPs (default: system resolvers)
DNS_SERVERS=
# 1 = accept invalid TLS certificates when fetching pages
FETCH_INSECURE_TLS=0

# --- API ---------------------------------------------------------------
# 1 = /api/analyze uses only the recorded fixtures (no network)
ANALYZE_OFFLINE=0

# --- Media adapters (opt-in: enrich/pipeline --ocr --asr --audio) ------
# whisper.cpp ggml model for whisper-cli (default: ~/models/whisper/ggml-large-v3-turbo.bin)
WHISPER_MODEL=
# mlx-whisper model (path or Hugging Face id already in the local cache; never downloaded)
MLX_WHISPER_MODEL=
# CLIP model for --clip (default: Xenova/clip-vit-base-patch32, fetched once from Hugging Face)
CLIP_MODEL=
# Python with SpeechBrain for --speaker (default: .venv-speaker/bin/python from scripts/py/setup-speaker.sh)
SPEAKER_PYTHON=
# ECAPA speaker model directory (default: ~/models/speechbrain/spkrec-ecapa-voxceleb)
SPEAKER_MODEL_DIR=
# Python with meta-ads-collector for --ad-library (default: the interpreter of `meta-ads-collector` on PATH)
META_ADS_PYTHON=

# --- CT watcher (bun run ct:watch / ct:backfill) -----------------------
# Comma-separated CertStream WebSocket URLs, tried in order
# (default: ws://127.0.0.1:8181/ from `docker compose --profile ct up -d certstream`, then wss://certstream.calidog.io/)
CT_STREAM_URL=
# Append-only JSONL feed read by /api/ct-feed (default: data/ct-watch.jsonl)
CT_FEED_FILE=

# --- Public address ------------------------------------------------------
# Requests per client (X-Forwarded-For / X-Real-IP) per window for /api/analyze, /api/analyze-material and /api/material; over it: 429. 0/empty = no limit.
ANALYZE_RATE_LIMIT=
ANALYZE_RATE_WINDOW_S=60
# Upload limit of the GUI analysis (MB, default 200): over it 413. With a public address also set ANALYZE_OFFLINE=1 (no page fetching).
MATERIAL_MAX_MB=

# --- Container / evaluators (docker-compose.yml sets these) --------------
# Run (graph.json, campaigns.json, enriched.json) the GUI shows and `analyze-material` compares with; `bun run base` writes it here
VIEWER_DATA_DIR=
# Output folder of `bun run demo` (default: dane/demo)
DEMO_OUT=
# Folder of the files uploaded in the GUI (default: the system temp folder)
MATERIAL_WORK_DIR=
# Path of the bun binary the GUI uses to start the analysis (default: bun from PATH)
BUN_BIN=
# Time zone for dates read from screenshots; without it firstSeen shifts by 2 h in a UTC container
TZ=Europe/Warsaw
# 1 = local models only: CLIP is skipped (with the reason) when its model is not on disk, nothing is downloaded
HF_HUB_OFFLINE=0
# Host folders mounted by the compose profile `full`
WHISPER_MODEL_DIR=
SPEAKER_MODEL_HOST=
