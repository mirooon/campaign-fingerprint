# --- LLM ---------------------------------------------------------------
# ollama (default, local/offline) | anthropic (only if the task rules allow external APIs)
LLM_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
# PLLuM (default) or Bielik:
OLLAMA_MODEL=hf.co/mradermacher/PLLuM-12B-instruct-2512-GGUF:Q5_K_M
# OLLAMA_MODEL=SpeakLeash/bielik-11b-v3.0-instruct:Q5_K_M
OLLAMA_EMBED_MODEL=bge-m3
LLM_TIMEOUT_MS=180000

# Anthropic (credentials can also come from `ant auth login`)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
ANTHROPIC_EFFORT=medium

# --- Graph -------------------------------------------------------------
# Text similarity in build-graph: tfidf (offline) | embedding (Ollama bge-m3) | none
TEXT_SIMILARITY=tfidf
# Linking config override for /api/analyze (default: data/sample/linking.json)
LINK_CONFIG=

# --- Enrichment (passive lookups) -------------------------------------
CACHE_DIR=.cache
# off = no cache reads/writes
CACHE=on
# off = skip crt.sh (slow)
CT=on
# Comma-separated resolver IPs (default: system resolvers)
DNS_SERVERS=
# 1 = accept invalid TLS certificates when fetching pages
FETCH_INSECURE_TLS=0

# --- API ---------------------------------------------------------------
# 1 = /api/analyze uses only the recorded fixtures (no network)
ANALYZE_OFFLINE=0

# --- Media adapters (opt-in: enrich/pipeline --ocr --asr --audio) ------
# whisper.cpp ggml model for whisper-cli (default: ~/models/whisper/ggml-large-v3-turbo.bin)
WHISPER_MODEL=
# mlx-whisper model (path or Hugging Face id already in the local cache; never downloaded)
MLX_WHISPER_MODEL=
# CLIP model for --clip (default: Xenova/clip-vit-base-patch32, fetched once from Hugging Face)
CLIP_MODEL=
# Python with SpeechBrain for --speaker (default: .venv-speaker/bin/python from scripts/py/setup-speaker.sh)
SPEAKER_PYTHON=
# ECAPA speaker model directory (default: ~/models/speechbrain/spkrec-ecapa-voxceleb)
SPEAKER_MODEL_DIR=
# Python with meta-ads-collector for --ad-library (default: the interpreter of `meta-ads-collector` on PATH)
META_ADS_PYTHON=

# --- CT watcher (bun run ct:watch / ct:backfill) -----------------------
# Comma-separated CertStream WebSocket URLs, tried in order
# (default: ws://127.0.0.1:8181/ from `docker compose --profile ct up -d certstream`, then wss://certstream.calidog.io/)
CT_STREAM_URL=
# Append-only JSONL feed read by /api/ct-feed (default: data/ct-watch.jsonl)
CT_FEED_FILE=
